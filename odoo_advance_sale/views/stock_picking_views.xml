<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_advance_delivery" model="ir.ui.view">
        <field name="name">stock.picking.form.advance.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_create_advance_sale" type="object" string="Create Advance Sale"
                        class="oe_highlight" groups="sales_team.group_sale_salesman"
                        invisible="not is_advance_delivery or state != 'done' or sale_id"/>
                <button name="action_create_advance_sale" type="object" string="Open Advance Sale"
                        groups="sales_team.group_sale_salesman"
                        invisible="not is_advance_delivery or not sale_id"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="ADVANCE DELIVERY" bg_color="text-bg-info"
                        invisible="not is_advance_delivery"/>
                <field name="sale_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_advance_delivery" readonly="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
    <record id="action_advance_deliveries" model="ir.actions.act_window">
        <field name="name">Advance Deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar,activity</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="domain">[('is_advance_delivery', '=', True), ('picking_type_code', '=', 'outgoing')]</field>
        <field name="context">{'default_is_advance_delivery': True, 'restricted_picking_type_code': 'outgoing'}</field>
    </record>
    <record id="action_open_advance_deliveries" model="ir.actions.server">
        <field name="name">Advance Deliveries</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_advance_deliveries()</field>
    </record>
    <menuitem id="menu_advance_deliveries" name="Advance Deliveries"
              parent="stock.menu_stock_transfers" action="action_open_advance_deliveries"
              sequence="22" groups="stock.group_stock_user"/>
</odoo>
