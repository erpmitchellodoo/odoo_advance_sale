<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_advance_sale" model="ir.ui.view">
        <field name="name">sale.order.form.advance.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_convert_to_advance_sale" type="object"
                        string="Convert to Advance Sale"
                        invisible="is_advance_sale or state not in ('draft', 'sent') or locked"/>
            </xpath>
            <xpath expr="//form/sheet" position="inside">
                <widget name="web_ribbon" title="ADVANCE SALE" bg_color="text-bg-info"
                        invisible="not is_advance_sale"/>
                <field name="is_advance_sale" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']" position="inside">
                <field name="is_advance_sale"
                       readonly="state not in ('draft', 'sent') or locked or advance_delivery_id"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']" position="inside">
                <field name="advance_delivery_id" invisible="not advance_delivery_id"/>
            </xpath>
            <xpath expr="//group[@name='sale_header']//field[@name='partner_id']" position="attributes">
                <attribute name="readonly" add="advance_delivery_id" separator=" or "/>
            </xpath>
            <xpath expr="//group[@name='sale_header']//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly" add="advance_delivery_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="advance_move_id" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="readonly" add="advance_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly" add="advance_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom'][@groups='uom.group_uom']" position="attributes">
                <attribute name="readonly" add="advance_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form" position="inside">
                <field name="advance_move_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="readonly" add="advance_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly" add="advance_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom'][@groups='uom.group_uom']" position="attributes">
                <attribute name="readonly" add="advance_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="attributes">
                <attribute name="readonly" add="advance_move_id" separator=" or "/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_search_advance_sale" model="ir.ui.view">
        <field name="name">sale.order.search.advance.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group" position="before">
                <separator/>
                <filter name="advance_sale" string="Advance Sale"
                        domain="[('is_advance_sale', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="action_advance_sales" model="ir.actions.act_window">
        <field name="name">Advance Sales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="domain">[('is_advance_sale', '=', True)]</field>
        <field name="context">{'default_is_advance_sale': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an advance sale quotation</p>
            <p>Use the standard quotation, confirmation, delivery and invoicing workflow.</p>
        </field>
    </record>
    <menuitem id="menu_advance_sales" name="Advance Sales"
              parent="sale.sale_order_menu" action="action_advance_sales"
              groups="sales_team.group_sale_salesman" sequence="25"/>
</odoo>
